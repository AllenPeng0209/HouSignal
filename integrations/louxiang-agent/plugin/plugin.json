{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "louxiang",
  "version": "0.1.0",
  "description": "连接楼响工作区，读取真实房源与参考，保存策划并提交制作任务。",
  "author": { "name": "楼响" },
  "homepage": "https://louxiang-preview.lovelingo.love/",
  "keywords": ["real-estate", "content", "production"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "楼响",
        "shortDescription": "房源研究、内容策划与制作任务",
        "longDescription": "使用浏览器授权连接楼响云端。外部 Agent 和 Web 使用同一套项目、策划和任务数据。",
        "developerName": "楼响",
        "category": "Productivity",
        "capabilities": ["Read", "Write"],
        "websiteURL": "https://louxiang-preview.lovelingo.love/",
        "defaultPrompt": ["查看我的楼响项目，为这套房产提出三个有来源的内容选题，并列出缺少的镜头。"],
        "brandColor": "#2458FF"
      }
    }
  }
}
