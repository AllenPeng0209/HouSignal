# Copy the repository .env.example to .env, then merge these production fields.
# Actual .env must remain private (chmod 600), outside Git and backups.
COMPOSE_PROJECT_NAME=louxiang-prod
LOUXIANG_API_IMAGE=louxiang-api:local
LOUXIANG_WEB_IMAGE=louxiang-web:local
LOUXIANG_TUNNEL_IMAGE=louxiang-tunnel:local
APP_ENV=production
DEPLOY_ORIGIN=https://studio.example.org
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_VALUE_AT_LEAST_32_CHARACTERS
SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
PII_ENCRYPTION_KEY=REPLACE_WITH_URL_SAFE_BASE64_OF_32_RANDOM_BYTES
BOOTSTRAP_EMAIL=owner@example.org
BOOTSTRAP_PASSWORD=REPLACE_WITH_INDEPENDENT_ADMIN_PASSWORD
# Linux cloud host: configure cloud providers or a remotely reachable owned PPU.
# localhost here is inside a container, not the Mac or the ECS host.
NATIVE_TEXT_BACKEND=dashscope
DASHSCOPE_API_KEY=
