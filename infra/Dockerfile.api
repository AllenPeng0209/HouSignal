FROM node:22.19.0-bookworm-slim AS pi_runtime
WORKDIR /agent-runtime
COPY apps/agent-runtime/package*.json ./
RUN npm ci --omit=dev
COPY apps/agent-runtime/engine.mjs apps/agent-runtime/bridge.mjs ./

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-noto-cjk fonts-wqy-microhei procps && command -v ps && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/api/requirements.lock /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY vendor/easel_accounts/requirements.txt /app/platform-requirements.txt
RUN pip install --no-cache-dir -r /app/platform-requirements.txt && python -m playwright install --with-deps chromium
COPY apps/api /app/apps/api
COPY --from=pi_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=pi_runtime /agent-runtime /app/apps/agent-runtime
COPY scripts /app/scripts
COPY vendor/easel_accounts /app/vendor/easel_accounts
COPY alembic.ini /app/alembic.ini
ENV PYTHONPATH=/app/apps/api FFMPEG_BINARY=/usr/bin/ffmpeg FFPROBE_BINARY=/usr/bin/ffprobe
EXPOSE 8017
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8017"]
