APP_ENV=development
# Optional daily application token quotas: 0 is unlimited; positive values cap usage.
DAILY_TOKEN_BUDGET=0
DEVELOPMENT_TOKEN_BUDGET=0
NATIVE_LOCAL_TEXT_DAILY_TOKEN_BUDGET=0
DATABASE_URL=
MIGRATION_DATABASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_CHAT_MODEL=
# mlx keeps text generation offline; weights must be below STORAGE_ROOT/models.
# The public research search API remains separate and may be metered.
NATIVE_TEXT_BACKEND=dashscope
NATIVE_TEXT_MODEL_PATH=
NATIVE_TEXT_MAX_CONCURRENCY=1
NATIVE_TEXT_MAX_CONTEXT_TOKENS=16384
NATIVE_TEXT_TIMEOUT_SECONDS=300
# Optional existing PPU text runtime; token stays in a private 0600 file.
NATIVE_RESIDENT_TEXT_BASE_URL=http://127.0.0.1:18891/v1
NATIVE_RESIDENT_TEXT_MODEL=housignal-qwen3-vl-32b-text
NATIVE_RESIDENT_TEXT_TOKEN_PATH=
NATIVE_RESIDENT_TEXT_TIMEOUT_SECONDS=285
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_IMAGE_MODEL=
DASHSCOPE_VIDEO_MODEL=
# Use a project-owned private SSH tunnel to the resident LightX2V H3 runtime.
# native_video_backend=lightx2v does not use a DashScope API key or an Easel gateway.
NATIVE_VIDEO_BACKEND=dashscope
NATIVE_VIDEO_BASE_URL=
NATIVE_VIDEO_MODEL=minimax-h3-dense8
NATIVE_VIDEO_TIMEOUT_SECONDS=900
DASHSCOPE_MUSIC_MODEL=
DASHSCOPE_TTS_MODEL=
DASHSCOPE_TTS_VOICE=
NATIVE_WHISPER_MODEL_PATH=
NATIVE_BACKGROUND_MODEL_PATH=
NATIVE_MUSIC_BASE_URL=
NATIVE_MUSIC_PROVIDER=dashscope
NATIVE_MUSIC_API_KEY=
NATIVE_MUSIC_DOWNLOAD_HOSTS=
NATIVE_SHORT_LINK_BASE_URL=
NATIVE_SHORT_LINK_API_KEY=
NATIVE_SHORT_LINK_ALLOWED_HOSTS=
NATIVE_NOTIFICATION_WEBHOOK_URL=
NATIVE_NOTIFICATION_KEY=
NATIVE_NOTIFICATION_ALLOWED_HOSTS=
SECRET_KEY=
PII_ENCRYPTION_KEY=
STORAGE_ROOT=.//.runtime/storage
BOOTSTRAP_EMAIL=owner@housignal.local
BOOTSTRAP_PASSWORD=
ALLOWED_ORIGINS=http://127.0.0.1:5177,http://localhost:5177,http://127.0.0.1:8017
FFMPEG_BINARY=/opt/homebrew/bin/ffmpeg
FFPROBE_BINARY=/opt/homebrew/bin/ffprobe
WORKER_DATABASE_URL=
POSTGRES_PASSWORD=

